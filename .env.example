# Copy to .env. All settings use the KS_ prefix (see src/knowledge_search/config.py).
KS_DB_PASSWORD=change-me-long-random
KS_COOKIE_SECURE=true
KS_HOSTNAME=search.example.internal
# Native (non-Docker) runs:
# KS_DATABASE_URL=postgresql://ks:devpass@127.0.0.1:55432/ks
# KS_DATA_DIR=./data
# KS_MODEL_CACHE=./data/models
# KS_OFFLINE=1   # forbid model downloads at runtime
